# Copy this file to .env and fill in your own values. Never commit .env.
# The backend and the frontend (Vite) both read this file from the repo root.

# --- OpenAI -------------------------------------------------------------------
# Used for:
#   - ChatGPT: Oli's live conversation (interview, pitch, debate). Oli only asks
#     questions and argues back; the rule engine does all the grading.
#   - Whisper API: transcribing each answer during live mode, and full takes
#     when PODIUM_WHISPER_BACKEND=openai.
# Record mode with the local Whisper backend works without a key.
OPENAI_API_KEY=

# ChatGPT model for Oli.
PODIUM_OLI_MODEL=gpt-4o-mini

# --- Supabase (login and video storage) ----------------------------------------
# Project settings -> API in the Supabase dashboard.
# Leave SUPABASE_URL empty to run without login (everyone shares a demo account).
SUPABASE_URL=
# Public anon key: safe in the browser, used by the frontend to sign users in.
SUPABASE_ANON_KEY=
# Service role key: SERVER ONLY, never put it in a VITE_ variable. Used to store videos.
SUPABASE_SERVICE_ROLE_KEY=
# Only for older projects that still sign tokens with a shared secret (HS256).
# Newer projects use signing keys, which the server fetches automatically.
SUPABASE_JWT_SECRET=
# Private bucket for take videos (create it in Storage, with "Public bucket" off).
SUPABASE_STORAGE_BUCKET=recordings

# The frontend reads these (Vite only exposes variables that start with VITE_).
VITE_SUPABASE_URL=${SUPABASE_URL}
VITE_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}

# --- Video storage --------------------------------------------------------------
# Where the kept copy of each take goes after analysis (a 480p MP4, about 3 MB a minute).
# The raw upload and video frames are deleted once the analysis finishes.
#   local:    storage/takes/<id>/ on this server (fine for development)
#   supabase: the private SUPABASE_STORAGE_BUCKET above
PODIUM_VIDEO_STORE=local
# Delete kept videos after this many days. Scores and feedback are kept.
PODIUM_VIDEO_RETENTION_DAYS=30

# --- Whisper (full takes) ---------------------------------------------------------
# "local" (faster-whisper, free, runs on your CPU) or "openai" (Whisper API, about $0.006 a minute).
PODIUM_WHISPER_BACKEND=local
# Local model: small.en for development, medium.en for accuracy, base.en if your laptop is slow.
PODIUM_WHISPER_MODEL=small.en
PODIUM_WHISPER_DEVICE=cpu
PODIUM_WHISPER_COMPUTE=int8
# Whisper API model (used for live mode, and full takes when the backend is "openai").
PODIUM_WHISPER_API_MODEL=whisper-1

# --- Server -------------------------------------------------------------------------
# Recordings, the SQLite database, and downloaded models.
PODIUM_STORAGE_DIR=storage
# Frontend origins allowed to call the API (comma separated).
PODIUM_CORS_ORIGIN=http://localhost:5173
# How many takes are analyzed at once (Whisper and MediaPipe are CPU heavy); the rest queue.
PODIUM_MAX_CONCURRENT_JOBS=2
# How many takes one user can have processing at the same time.
PODIUM_MAX_PROCESSING_PER_USER=2
# "off" disables rate limiting (only for local testing).
PODIUM_RATE_LIMITS=on
